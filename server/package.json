{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "Civic Issue Tracker API — Node.js + Express + TypeScript + MongoDB",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mongoose": "^9.10.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "vitest": "^5.0.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.0.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.16.1",
    "@typescript-eslint/eslint-plugin": "^7.16.1"
  }
}
